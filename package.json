{
  "name": "logger-browser",
  "description": "Logger for browser",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "npm run build:dist && npm run build:lib",
    "build:dist": "vite build --mode app",
    "build:lib": "vite build --mode lib",
    "preview": "vite preview --outDir dist --open",
    "format": "biome check --write .",
    "lint": "npm run lint:biome && npm run lint:ts",
    "lint:biome": "biome lint --error-on-warnings . && biome check .",
    "lint:ts": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "opencode": "npm exec opencode -- .",
    "commit": "npm exec opencode -- run --command commit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@testing-library/jest-dom": "6.9.1",
    "@vitejs/plugin-react": "6.0.4",
    "happy-dom": "20.11.1",
    "opencode-ai": "1.18.8",
    "typescript": "5.8.2",
    "vite": "8.1.5",
    "vite-plugin-dts": "5.0.1",
    "vitest": "4.1.7"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "5.0.1",
    "bowser": "2.11.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "opencode-ai@1.18.8": true
  }
}
